{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.catvba.invalid/target-evidence/common.schema.json",
  "$ref": "#/$defs/binding",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "opaque_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)+$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^session-[a-z0-9][a-z0-9-]{2,94}$"
    },
    "kit_id": {
      "type": "string",
      "pattern": "^kit-[0-9a-f]{16,64}$"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^handoff-[a-z0-9][a-z0-9-]{2,94}$"
    },
    "record_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "allOf": [
        {"pattern": "^[ -~]+$"},
        {"not": {"pattern": "[<>:\"\\\\|?*]"}},
        {"not": {"pattern": "(?:^/|/$|//|\\\\)"}},
        {"not": {"pattern": "(?:^|/)\\.{1,2}(?:/|$)"}},
        {"not": {"pattern": "[ .](?:/|$)"}},
        {
          "not": {
            "pattern": "(?i)(?:^|/)(?:CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\\.[^/]*)?(?:/|$)"
          }
        }
      ]
    },
    "nullable_record_id": {
      "oneOf": [
        {"$ref": "#/$defs/record_id"},
        {"type": "null"}
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "session_id",
        "session_mode",
        "package_id",
        "profile_id",
        "kit_id",
        "catalog_sha256",
        "manifest_sha256",
        "manifest_digest",
        "work_commit",
        "work_tree",
        "handoff_id",
        "target"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "session_id": {"$ref": "#/$defs/session_id"},
        "session_mode": {"enum": ["discovery", "g2", "g3-c"]},
        "package_id": {"const": "core"},
        "profile_id": {
          "enum": ["DISCOVERY", "P-AB3", "P-HD2", "P-MD2", "P-ALL", "P-PROD"]
        },
        "kit_id": {"$ref": "#/$defs/kit_id"},
        "catalog_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_digest": {"$ref": "#/$defs/sha256"},
        "work_commit": {"$ref": "#/$defs/git_oid"},
        "work_tree": {"$ref": "#/$defs/git_oid"},
        "handoff_id": {"$ref": "#/$defs/handoff_id"},
        "target": {"const": "CATIA R2018/VBA7 64"}
      },
      "allOf": [
        {
          "if": {
            "required": ["session_mode"],
            "properties": {"session_mode": {"const": "discovery"}}
          },
          "then": {"properties": {"profile_id": {"const": "DISCOVERY"}}}
        },
        {
          "if": {
            "required": ["session_mode"],
            "properties": {"session_mode": {"enum": ["g2", "g3-c"]}}
          },
          "then": {
            "properties": {
              "profile_id": {
                "enum": ["P-AB3", "P-HD2", "P-MD2", "P-ALL", "P-PROD"]
              }
            }
          }
        }
      ]
    },
    "binding_property": {
      "type": "object",
      "required": ["binding"],
      "properties": {
        "binding": {"$ref": "#/$defs/binding"}
      }
    },
    "status_with_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "operator_record_id"],
      "properties": {
        "status": {
          "enum": ["not-run", "observed", "available", "unavailable", "blocked", "failed"]
        },
        "operator_record_id": {"$ref": "#/$defs/nullable_record_id"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "not-run"}}},
          "then": {"properties": {"operator_record_id": {"type": "null"}}}
        }
      ]
    }
  }
}
