{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.catvba.invalid/target-evidence/payload-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "members", "evidence_payload_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"$ref": "https://schemas.catvba.invalid/target-evidence/common.schema.json#/$defs/session_id"},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {
            "$ref": "https://schemas.catvba.invalid/target-evidence/common.schema.json#/$defs/portable_path",
            "not": {
              "enum": [
                "payload-manifest.json", "gate-receipt.json", "approval.json",
                "SHA256SUMS", "SESSION_COMPLETE"
              ]
            }
          },
          "sha256": {"$ref": "https://schemas.catvba.invalid/target-evidence/common.schema.json#/$defs/sha256"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "evidence_payload_digest": {"$ref": "https://schemas.catvba.invalid/target-evidence/common.schema.json#/$defs/sha256"}
  }
}
