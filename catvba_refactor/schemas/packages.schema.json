{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "packages.schema.json",
  "title": "Macro Menu package policy configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packages"],
  "properties": {
    "schema_version": {"const": 1},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/package"}
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,63}$"
    },
    "string_set": {
      "type": "array",
      "uniqueItems": true,
      "default": [],
      "items": {"type": "string", "minLength": 1}
    },
    "reference_id": {
      "type": "string",
      "pattern": "^ref\\.[0-9a-f]{32}\\.[0-9]+\\.[0-9]+$"
    },
    "reference_id_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reference_id"}
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "definition_path_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_kind",
        "allowed_basenames",
        "allowed_relative_paths",
        "canonical_path_sha256"
      ],
      "properties": {
        "root_kind": {"enum": ["catia-install", "windows-install", "system"]},
        "allowed_basenames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9._ -]{1,100}$"}
        },
        "allowed_relative_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._ -]+(?:/[A-Za-z0-9._ -]+)*$"
          }
        },
        "canonical_path_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "reference_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_reference_id",
        "guid",
        "major",
        "minor",
        "allowed_names",
        "allowed_descriptions",
        "source_classification",
        "architecture",
        "release_provenance",
        "path_policy"
      ],
      "properties": {
        "stable_reference_id": {"$ref": "#/$defs/reference_id"},
        "guid": {
          "type": "string",
          "pattern": "^\\{[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}\\}$"
        },
        "major": {"type": "integer", "minimum": 0},
        "minor": {"type": "integer", "minimum": 0},
        "allowed_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "allowed_descriptions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 320}
        },
        "source_classification": {
          "enum": ["builtin", "host-default", "package-added", "import-introduced"]
        },
        "architecture": {"const": "x64"},
        "release_provenance": {"const": "B28"},
        "path_policy": {"$ref": "#/$defs/definition_path_policy"}
      }
    },
    "observation_points": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blank-project",
        "post-form-import",
        "post-all-import",
        "post-save",
        "post-restart"
      ],
      "properties": {
        "blank-project": {"$ref": "#/$defs/reference_id_set"},
        "post-form-import": {"$ref": "#/$defs/reference_id_set"},
        "post-all-import": {"$ref": "#/$defs/reference_id_set"},
        "post-save": {"$ref": "#/$defs/reference_id_set"},
        "post-restart": {"$ref": "#/$defs/reference_id_set"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "added", "removed"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "added": {"$ref": "#/$defs/reference_id_set"},
        "removed": {"$ref": "#/$defs/reference_id_set"}
      }
    },
    "transitions": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/transition",
          "properties": {"from": {"const": "blank-project"}, "to": {"const": "post-form-import"}}
        },
        {
          "$ref": "#/$defs/transition",
          "properties": {"from": {"const": "post-form-import"}, "to": {"const": "post-all-import"}}
        },
        {
          "$ref": "#/$defs/transition",
          "properties": {"from": {"const": "post-all-import"}, "to": {"const": "post-save"}}
        },
        {
          "$ref": "#/$defs/transition",
          "properties": {"from": {"const": "post-save"}, "to": {"const": "post-restart"}}
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "global_path_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_root_kinds", "allow_user_paths"],
      "properties": {
        "allowed_root_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["catia-install", "windows-install", "system"]}
        },
        "allow_user_paths": {"const": false}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_approval_record_id",
        "reviewer_role",
        "approved_at",
        "discovery_session_id",
        "discovery_bundle_sha256",
        "discovery_gate_receipt_sha256",
        "observation_approval_sha256",
        "approved_contract_body_digest"
      ],
      "properties": {
        "reference_approval_record_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "reviewer_role": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "approved_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "discovery_session_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "discovery_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "discovery_gate_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "observation_approval_sha256": {"$ref": "#/$defs/sha256"},
        "approved_contract_body_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "discovery_reference_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_version",
        "observation_points",
        "reference_definitions",
        "status",
        "transitions"
      ],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^references\\.[a-z][a-z0-9._-]{2,63}\\.b28$"},
        "contract_version": {"const": 1},
        "observation_points": {"type": "null"},
        "reference_definitions": {"type": "null"},
        "status": {"const": "discovery-required"},
        "transitions": {"type": "null"}
      }
    },
    "approved_reference_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_version",
        "status",
        "reference_definitions",
        "observation_points",
        "transitions",
        "path_policy",
        "contract_body_digest",
        "approval"
      ],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^references\\.[a-z][a-z0-9._-]{2,63}\\.b28$"},
        "contract_version": {"const": 1},
        "status": {"const": "approved"},
        "reference_definitions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/reference_definition"}
        },
        "observation_points": {"$ref": "#/$defs/observation_points"},
        "transitions": {"$ref": "#/$defs/transitions"},
        "path_policy": {"$ref": "#/$defs/global_path_policy"},
        "contract_body_digest": {"$ref": "#/$defs/sha256"},
        "approval": {"$ref": "#/$defs/approval"}
      }
    },
    "reference_contract": {
      "oneOf": [
        {"$ref": "#/$defs/discovery_reference_contract"},
        {"$ref": "#/$defs/approved_reference_contract"}
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "classification",
        "reference_allowlist",
        "reference_contract"
      ],
      "properties": {
        "package_id": {"$ref": "#/$defs/stable_id"},
        "classification": {
          "enum": [
            "CORE_CANDIDATE",
            "FLEET_EXTENSION_SPA",
            "FLEET_EXTENSION_FTA",
            "BASELINE_EXTENSION_CANDIDATE",
            "CATIA_LICENSED_OPTIONAL_CANDIDATE",
            "EXTERNAL_INTEGRATION_OPTIONAL",
            "DEVTOOLS",
            "QUARANTINE"
          ]
        },
        "additional_deny_tokens": {"$ref": "#/$defs/string_set"},
        "reference_allowlist": {"$ref": "#/$defs/reference_id_set"},
        "reference_contract": {"$ref": "#/$defs/reference_contract"}
      }
    }
  }
}
