{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "packages.schema.json",
  "title": "Macro Menu package policy configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packages"],
  "properties": {
    "schema_version": {"const": 1},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/package"}
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,63}$"
    },
    "string_set": {
      "type": "array",
      "uniqueItems": true,
      "default": [],
      "items": {"type": "string", "minLength": 1}
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "classification"],
      "properties": {
        "package_id": {"$ref": "#/$defs/stable_id"},
        "classification": {
          "enum": [
            "CORE_CANDIDATE",
            "FLEET_EXTENSION_SPA",
            "FLEET_EXTENSION_FTA",
            "BASELINE_EXTENSION_CANDIDATE",
            "CATIA_LICENSED_OPTIONAL_CANDIDATE",
            "EXTERNAL_INTEGRATION_OPTIONAL",
            "DEVTOOLS",
            "QUARANTINE"
          ]
        },
        "additional_deny_tokens": {"$ref": "#/$defs/string_set"},
        "reference_allowlist": {"$ref": "#/$defs/string_set"}
      }
    }
  }
}
