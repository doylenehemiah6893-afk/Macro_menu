{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.catvba.invalid/target-evidence/approval.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "approval_id", "session_id", "session_mode", "gate_id",
    "evidence_payload_digest", "gate_receipt_sha256", "approval_scope",
    "approval_status", "reviewer_role", "review_record_id", "approved_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "approval_id": {"$ref": "https://schemas.catvba.invalid/target-evidence/common.schema.json#/$defs/opaque_id"},
    "session_id": {"$ref": "https://schemas.catvba.invalid/target-evidence/common.schema.json#/$defs/session_id"},
    "session_mode": {"enum": ["discovery", "g2", "g3-c"]},
    "gate_id": {"enum": ["DISCOVERY", "G2", "G3-C"]},
    "evidence_payload_digest": {"$ref": "https://schemas.catvba.invalid/target-evidence/common.schema.json#/$defs/sha256"},
    "gate_receipt_sha256": {"$ref": "https://schemas.catvba.invalid/target-evidence/common.schema.json#/$defs/sha256"},
    "approval_scope": {"enum": ["observation", "gate"]},
    "approval_status": {"enum": ["pending", "approved", "rejected"]},
    "reviewer_role": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "review_record_id": {"$ref": "https://schemas.catvba.invalid/target-evidence/common.schema.json#/$defs/record_id"},
    "approved_at": {"$ref": "https://schemas.catvba.invalid/target-evidence/common.schema.json#/$defs/utc"}
  },
  "allOf": [
    {
      "if": {"properties": {"session_mode": {"const": "discovery"}}},
      "then": {
        "properties": {
          "gate_id": {"const": "DISCOVERY"},
          "approval_scope": {"const": "observation"}
        }
      }
    },
    {
      "if": {"properties": {"session_mode": {"const": "g2"}}},
      "then": {"properties": {"gate_id": {"const": "G2"}, "approval_scope": {"const": "gate"}}}
    },
    {
      "if": {"properties": {"session_mode": {"const": "g3-c"}}},
      "then": {"properties": {"gate_id": {"const": "G3-C"}, "approval_scope": {"const": "gate"}}}
    }
  ]
}
