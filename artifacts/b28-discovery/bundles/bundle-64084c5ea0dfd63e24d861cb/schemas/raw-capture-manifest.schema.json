{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.catvba.invalid/raw-capture-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "session_id", "created_at", "trust_level", "mode",
    "package_id", "profile_id", "bundle_id", "kit_id", "handoff_id",
    "compile_status", "target_case_status", "artifact_status", "release_eligible",
    "members"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "session_id": {"type": "string", "pattern": "^session-[a-z0-9][a-z0-9-]{2,94}$"},
    "created_at": {"$ref": "#/$defs/utc"},
    "trust_level": {"const": "raw-untrusted"},
    "mode": {"const": "discovery"},
    "package_id": {"const": "core"},
    "profile_id": {"const": "DISCOVERY"},
    "bundle_id": {"type": "string", "pattern": "^bundle-[0-9a-f]{24}$"},
    "kit_id": {"type": "string", "pattern": "^kit-[0-9a-f]{16,64}$"},
    "handoff_id": {"type": "string", "pattern": "^handoff-[a-z0-9][a-z0-9-]{2,94}$"},
    "compile_status": {"const": "not-run"},
    "target_case_status": {"const": "not-run"},
    "artifact_status": {"const": "not-produced"},
    "release_eligible": {"const": false},
    "members": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"$ref": "#/$defs/portable_path"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "portable_path": {
      "type": "string", "minLength": 1, "maxLength": 240,
      "allOf": [
        {"pattern": "^[ -~]+$"}, {"not": {"pattern": "[<>:\"\\\\|?*]"}},
        {"not": {"pattern": "(?:^/|/$|//|\\\\)"}},
        {"not": {"pattern": "(?:^|/)\\.{1,2}(?:/|$)"}},
        {"not": {"enum": ["raw-capture-manifest.json"]}}
      ]
    }
  }
}
