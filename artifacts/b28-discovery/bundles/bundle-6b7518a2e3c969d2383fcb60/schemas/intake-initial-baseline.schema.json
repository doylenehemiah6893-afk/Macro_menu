{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intake-initial-baseline.schema.json",
  "title": "CATVBA initial no-content intake baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "status",
    "recorded_date",
    "approver",
    "upstream",
    "fork",
    "work_pre_intake_commit",
    "merge_commit",
    "merge_reason",
    "trees",
    "changed_paths",
    "override_decisions",
    "checks",
    "superseded_kit_ids"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "initial_baseline"},
    "status": {"const": "accepted"},
    "recorded_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "approver": {"type": "string", "minLength": 1},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit"],
      "properties": {
        "repository": {"const": "verysolecd/Macro_menu"},
        "ref": {"const": "dev"},
        "commit": {"const": "abce8ffe37d25cc8f189ae9e9a2a1e942279a5ad"}
      }
    },
    "fork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit"],
      "properties": {
        "repository": {"const": "doylenehemiah6893-afk/Macro_menu"},
        "ref": {"const": "dev"},
        "commit": {"const": "abce8ffe37d25cc8f189ae9e9a2a1e942279a5ad"}
      }
    },
    "work_pre_intake_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "merge_commit": {"const": null},
    "merge_reason": {"const": "initial-baseline/no-content-intake"},
    "trees": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Src", "resources"],
      "properties": {
        "Src": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cutoff_oid", "work_oid"],
          "properties": {
            "cutoff_oid": {"const": "0f7263465cdd5ecd7dbe5ceff090cad859cc1173"},
            "work_oid": {"const": "0f7263465cdd5ecd7dbe5ceff090cad859cc1173"}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cutoff_oid", "work_oid"],
          "properties": {
            "cutoff_oid": {"const": "720c20864bff3c48694acaf780b50518f49b9a60"},
            "work_oid": {"const": "720c20864bff3c48694acaf780b50518f49b9a60"}
          }
        }
      }
    },
    "changed_paths": {"const": []},
    "override_decisions": {"const": []},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote_refs_equal",
        "cutoff_is_work_ancestor",
        "src_tree_equal",
        "resources_tree_equal",
        "reserved_namespace_absent",
        "portable_paths",
        "form_frx_pairs"
      ],
      "properties": {
        "remote_refs_equal": {"const": true},
        "cutoff_is_work_ancestor": {"const": true},
        "src_tree_equal": {"const": true},
        "resources_tree_equal": {"const": true},
        "reserved_namespace_absent": {"const": true},
        "portable_paths": {"const": "passed"},
        "form_frx_pairs": {"const": "passed"}
      }
    },
    "superseded_kit_ids": {"const": []}
  }
}
