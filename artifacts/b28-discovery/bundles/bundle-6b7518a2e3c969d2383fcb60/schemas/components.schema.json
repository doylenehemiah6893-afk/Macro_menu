{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "components.schema.json",
  "title": "Macro Menu component configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_roots", "components"],
  "properties": {
    "schema_version": {"const": 1},
    "source_roots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_root"}
    },
    "components": {
      "type": "array",
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,63}$"
    },
    "origin": {
      "enum": ["upstream", "new", "override", "shared", "quarantine"]
    },
    "disposition": {
      "enum": ["candidate", "quarantine", "retired"]
    },
    "source_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "origin",
        "path",
        "extensions",
        "default_disposition"
      ],
      "properties": {
        "root_id": {"$ref": "#/$defs/stable_id"},
        "origin": {"$ref": "#/$defs/origin"},
        "path": {"type": "string", "minLength": 1},
        "extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": [".bas", ".cls", ".frm", ".frx"]}
        },
        "default_disposition": {"$ref": "#/$defs/disposition"}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blob_oid", "raw_sha256", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "blob_oid": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {"enum": ["source", "frm", "frx"]}
      }
    },
    "member_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/member"}
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "origin",
        "component_type",
        "vb_name",
        "disposition",
        "members"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/stable_id"},
        "origin": {"$ref": "#/$defs/origin"},
        "component_type": {
          "enum": ["standard_module", "class_module", "user_form"]
        },
        "vb_name": {"type": "string", "minLength": 1},
        "package_id": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9._-]{2,63}$"
        },
        "disposition": {"$ref": "#/$defs/disposition"},
        "members": {"$ref": "#/$defs/member_list"},
        "base_members": {"$ref": "#/$defs/member_list"},
        "encoding_decision": {"enum": ["utf-8", "cp936"]}
      },
      "allOf": [
        {
          "if": {
            "required": ["origin"],
            "properties": {"origin": {"const": "override"}}
          },
          "then": {"required": ["base_members"]},
          "else": {"not": {"required": ["base_members"]}}
        },
        {
          "if": {
            "required": ["disposition"],
            "properties": {"disposition": {"const": "candidate"}}
          },
          "then": {
            "required": ["package_id"],
            "properties": {
              "package_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{2,63}$"
              }
            }
          }
        }
      ]
    }
  }
}
